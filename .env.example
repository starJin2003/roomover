# Client ID and secret of the PayPal sandbox app
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret

# ID of the webhook registered against the deployed app. Leave empty until it
# exists. The webhook route answers 503 while it is empty.
PAYPAL_WEBHOOK_ID=

# Anthropic Console key for the Claude calls Roomover makes
ANTHROPIC_API_KEY=your-anthropic-api-key

# Channel3 key for product identification and search
CHANNEL3_API_KEY=your-channel3-api-key

# Postgres connection string. Render sets this value in deployment.
DATABASE_URL=postgresql://roomover:roomover@localhost:5432/roomover

# At least 32 random characters, for example the output of `openssl rand -base64 32`
SESSION_SECRET=replace-with-at-least-32-random-characters

# Public base URL of the app. Log in with PayPal builds its redirect URI from it,
# and the sandbox app accepts 127.0.0.1 where it rejects localhost.
APP_URL=http://127.0.0.1:3000
