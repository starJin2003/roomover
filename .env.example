# Client ID and secret of the PayPal sandbox app
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret

# ID of the webhook registered against the deployed app. Leave empty until it
# exists. The webhook route answers 503 while it is empty.
PAYPAL_WEBHOOK_ID=

# Anthropic Console key for the Claude calls Roomover makes
ANTHROPIC_API_KEY=your-anthropic-api-key

# Channel3 key for product identification and search
CHANNEL3_API_KEY=your-channel3-api-key

# Postgres connection string. Render sets this value in deployment.
DATABASE_URL=postgresql://roomover:roomover@localhost:5432/roomover

# At least 32 random characters, for example the output of `openssl rand -base64 32`
SESSION_SECRET=replace-with-at-least-32-random-characters

# Public base URL of the app. Log in with PayPal builds its redirect URI from it,
# and the sandbox app accepts 127.0.0.1 where it rejects localhost.
APP_URL=http://127.0.0.1:3000

# Commit SHA of the running build. Render sets it on every deploy, and
# /api/health reports it. Leave it empty locally.
RENDER_GIT_COMMIT=

# Tests only. Path to a recorded Claude conversation the buyer agent replays
# in place of calling the API. Never set it in deployment.
ROOMOVER_CLAUDE_FIXTURE=

# Local development only. Path where live buyer agent runs save their Claude
# replies, which become the fixture above.
ROOMOVER_CLAUDE_RECORD=

# Tests only. Path to recorded verifier agent comparisons, keyed by the handoff
# photo, which the verifier replays in place of calling the API. Never set it
# in deployment.
ROOMOVER_VERIFIER_FIXTURE=

# Tests only. Password of the sandbox judge buyer, which the real checkout test
# types into the PayPal popup. The test skips when it is empty.
PAYPAL_SANDBOX_BUYER_PASSWORD=

# Live Sell run only. Password of sandbox seller 1 (Ava), which pnpm sell:run
# types into the Log in with PayPal page. Never set it in deployment.
PAYPAL_SANDBOX_SELLER_PASSWORD=

# Tests only. Path to recorded PayPal responses. PayPal calls go to a
# simulated sandbox built from them, so a test run moves no sandbox money.
# Playwright sets it unless ROOMOVER_E2E_LIVE is 1. Never set it in deployment.
ROOMOVER_PAYPAL_FIXTURE=

# Tests only. Path to recorded seller agent replies, keyed by the photo, which
# the seller agent replays in place of calling the API. Never set it in
# deployment.
ROOMOVER_SELLER_FIXTURE=

# Tests only. Path to recorded Channel3 image searches, keyed by the photo,
# which Sell replays in place of calling Channel3. Never set it in deployment.
ROOMOVER_CHANNEL3_FIXTURE=

# Tests only. Set to 1 to run checkout and handoff end to end against the real
# sandbox, which charges the judge buyer and pays the five sellers.
ROOMOVER_E2E_LIVE=
