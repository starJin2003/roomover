    "test:e2e": "playwright test",
    "room:benchmark": "tsx scripts/room/benchmark.ts",
    "furnish:run": "tsx --env-file-if-exists=.env.local scripts/furnish/real-run.ts",
    "handoff:samples": "tsx scripts/handoff/make-samples.ts",
    "handoff:record-verifier": "tsx --env-file-if-exists=.env.local scripts/handoff/record-verifier.ts",
    "handoff:run": "tsx --env-file-if-exists=.env.local scripts/handoff/real-run.ts",
    "paypal:smoke": "tsx --env-file-if-exists=.env.local scripts/paypal-smoke.ts",
    "paypal:webhook": "tsx --env-file-if-exists=.env.local scripts/paypal/register-webhook.ts",
    "paypal:payout-proof": "tsx --env-file-if-exists=.env.local scripts/paypal/payout-proof.ts",
    "paypal:resend": "tsx --env-file-if-exists=.env.local scripts/paypal/resend-event.ts",
    "paypal:venmo-probe": "tsx --env-file-if-exists=.env.local scripts/paypal/venmo-probe.ts",
